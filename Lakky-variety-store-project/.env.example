# Copy to .env.local and fill
DATABASE_URL=postgres://lakky:lakky_local_pw@localhost:5432/lakky_store

# Better Auth — generate with: openssl rand -base64 32 (never commit the real value)
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Admin seed (single admin V1)
ADMIN_EMAIL=owner@lakkyvariety.ng
ADMIN_PASSWORD=your-strong-password-here

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRODUCT_IMAGES=lakky-product-images
R2_BUCKET_PAYMENT_PROOFS=lakky-payment-proofs
R2_PUBLIC_URL=https://pub-xxx.r2.dev
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TIMEZONE=Africa/Lagos

# Web Push (owner phone alerts) — generate with: node scripts/gen-vapid.cjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@lakky.store
